# Copy to .env (chmod 600) and fill in. Never commit .env.
# Values containing $ must be single-quoted.

# DuckDNS
DUCKDNS_TOKEN=00000000-0000-0000-0000-000000000000
BASE_DOMAIN=your-subdomain.duckdns.org
JELLYFIN_HOST=random-string.your-subdomain.duckdns.org

# Other services
HOMARR_SECRET_KEY=generate-with-openssl-rand-hex-32
QBIT_PASSWORD='change-me'
